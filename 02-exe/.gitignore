# 02-exe gitignore
# Exclude active development checkout and worktrees
workspace/*
!workspace/.gitkeep

# Exclude local environment files and secret caches
.env
*.env
.env.local
.env.*.local
.secrets/

# Exclude ephemeral session runs and logs
runs/*
!runs/latest/.gitkeep
runs/latest/*
!runs/latest/.gitkeep

# Cross-process secret redaction registry (same handling as .env secrets)
.secret_registry.json
runs/latest/.secret_registry.json

# Python cache & build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
